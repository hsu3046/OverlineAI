          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up some iPhone storage to download the high-quality voice pack."
          }
        }
      }
    },
    "글을 임시 보관하지 못했습니다. 다시 시도해 주세요.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
