{
  "sourceLanguage": "ko",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "글조각 서랍"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用の引き出し"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quote Drawer"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "BZOGAK"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "책 페이지와 ISBN 바코드를 스캔해 글조각과 도서 정보를 저장하려면 카메라 접근이 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本のページやISBNバーコードをスキャンし、引用と本の情報を保存するためにカメラを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is needed to scan book pages and ISBN barcodes and save quotes and book information."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "내 주변의 서점과 도서관을 거리순으로 안내하기 위해 현재 위치를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くの書店や図書館を距離順に表示するために現在地を使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used to show nearby bookstores and libraries by distance."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "음성 메모를 텍스트로 바꾸기 위해 녹음할 때만 마이크를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声メモをテキストに変換するため、録音中のみマイクを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used only while recording voice memos for transcription."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - Speech Recognition Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "말한 메모를 기기에서 텍스트로 변환하기 위해 음성 인식 권한이 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声メモを端末上でテキストに変換するために音声認識を使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is needed to transcribe voice memos on your device."
          }
        }
      }
    },
    "글조각 서랍 백업": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用の引き出しのバックアップ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quote Drawer backup"
          }
        }
      }
    }
  },
  "version": "1.3"
}
