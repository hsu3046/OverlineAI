{
  "sourceLanguage": "ko",
  "strings": {
    "· %@": {},
    "%@": {},
    "%lld": {},
    "글조각": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quote"
          }
        }
      }
    },
    "다시 만난 글조각": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "また出会う引用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediscover quotes"
          }
        }
      }
    },
    "도서관 대출 순위": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図書館の貸出ランキング"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library loan rankings"
          }
        }
      }
    },
    "마음에 남은 문장을 담아보세요": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心に残った一文を残しましょう"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a sentence that stays with you"
          }
        }
      }
    },
    "베스트셀러": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベストセラー"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestsellers"
          }
        }
      }
    },
    "베스트셀러와 도서관 대출 순위를 살펴보세요.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベストセラーと図書館の貸出ランキングを見てみましょう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore bestsellers and library loan rankings."
          }
        }
      }
    },
    "순위": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランキング"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rankings"
          }
        }
      }
    },
    "순위를 불러오지 못했어요": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランキングを読み込めませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load rankings"
          }
        }
      }
    },
    "앱을 열어 글조각을 불러오세요": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いて引用を読み込んでください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app to load quotes"
          }
        }
      }
    },
    "인기 도서": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人気の本"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Popular books"
          }
        }
      }
    },
    "읽는 중": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading"
          }
        }
      }
    },
    "저장한 문장과 읽는 중인 책을 홈 화면에서 만나세요.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した文と読んでいる本をホーム画面で確認できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See saved quotes and current books on your Home Screen."
          }
        }
      }
    },
    "책": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books"
          }
        }
      }
    },
    "최근 글조각을 5분 간격으로 다시 만납니다.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の引用が5分ごとに更新されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediscover recent quotes every five minutes."
          }
        }
      }
    },
    "표시할 순위가 없어요": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示できるランキングがありません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rankings to show"
          }
        }
      }
    }
  },
  "version": "1.3"
}
